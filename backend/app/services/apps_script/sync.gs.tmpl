// COD Call Center -> Google Sheets importer (v2)
// Generated by Admin > Integrations. Keep CALL_CENTER_WEBHOOK and CALL_CENTER_TOKEN private.
const CALL_CENTER_WEBHOOK = __WEBHOOK__;
const CALL_CENTER_TOKEN = __TOKEN__;
const SOURCE_SHEET_NAME = __SHEET__;
const BATCH_SIZE = 150;

const STATUS_HEADER = 'CALL CENTER IMPORT STATUS';
const ORDER_HEADER = 'CALL CENTER ORDER ID';
const ERROR_HEADER = 'CALL CENTER IMPORT ERROR';
const HASH_HEADER = 'CALL CENTER ROW HASH';

const HEADER_ALIASES = {
  sku: ['SKU', 'Product SKU', 'Lineitem sku', 'Variant SKU'],
  customer_name: ['FULL NAME', 'Full Name', 'Name', 'Customer Name', 'Shipping Name'],
  phone: ['PHONE NUMBER', 'Phone Number', 'Phone', 'Mobile', 'Shipping Phone'],
  city: ['CITY', 'City', 'Shipping City'],
  address: ['ADDRESS', 'Address', 'Shipping Address', 'Address1'],
  quantity: ['QUANTITY', 'Quantity', 'Product Quantity', 'Qty', 'Lineitem quantity'],
  total_price: ['TOTAL PRICE MAD', 'Total Price MAD', 'Total Price', 'Total', 'Price', 'Amount'],
  product_name: ['PRODUCT NAME', 'Product Name', 'Lineitem name'],
  external_order_id: ['SHOPIFY ORDER ID', 'Shopify Order ID', 'Order ID', 'Order Number', 'Order Name'],
  lead_date: ['DATE', 'Date', 'Created At', 'Created', 'Timestamp', 'Order Date', 'Date Created', 'Created Time', 'Lead Date'],
  note: ['NOTE', 'Note', 'Notes']
};

function normalizeHeader(v) { return String(v || '').trim().toLowerCase(); }
function headerIndex(headers, aliases) {
  const normalized = headers.map(normalizeHeader);
  for (const alias of aliases) {
    const i = normalized.indexOf(normalizeHeader(alias));
    if (i >= 0) return i;
  }
  return -1;
}
function getCell(row, headers, key) {
  const i = headerIndex(headers, HEADER_ALIASES[key] || []);
  return i >= 0 ? row[i] : '';
}
function ensureColumn(sheet, headers, name) {
  const i = headers.map(normalizeHeader).indexOf(normalizeHeader(name));
  if (i >= 0) return i + 1;
  const col = headers.length + 1;
  sheet.getRange(1, col).setValue(name);
  headers.push(name);
  return col;
}

// Fingerprint of the business fields. A REJECTED row is only retried automatically when this changes (i.e. someone fixed it).
function rowHash_(sku, phone, name, qty, total) {
  const raw = [sku, String(phone).replace(/\D/g, ''), String(name).toLowerCase(), qty, total].join('|');
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, raw);
  return bytes.map(function (b) { return ('0' + (b < 0 ? b + 256 : b).toString(16)).slice(-2); }).join('').slice(0, 12);
}

// Decide whether a row must be (re)sent. mode: 'normal' | 'retryRejected' | 'all'
//  - IMPORTED/DUPLICATE are trusted ONLY when an order number was recorded; a bare IMPORTED marker is re-sent (server is idempotent).
//  - REJECTED (permanent: unknown/empty SKU, bad phone ...) is not retried every minute; it is retried when the row is edited or on demand.
//  - ERROR (transient: timeouts, DB conflicts ...) is retried with exponential backoff, at most MAX_ATTEMPTS times; the attempt
//    counter and next-retry time live in the ROW HASH column as "E<attempts>|<nextRetryMs>". After MAX_ATTEMPTS it needs a controlled retry.
const MAX_ATTEMPTS = 6;
function nextRetryState_(storedHash, nowMs) {
  const m = /^E(\d+)\|(\d+)$/.exec(String(storedHash || ''));
  const attempts = (m ? parseInt(m[1], 10) : 0) + 1;
  const delayMin = Math.min(Math.pow(2, attempts), 60);
  return 'E' + attempts + '|' + (nowMs + delayMin * 60000);
}
function shouldSend_(status, orderNo, storedHash, currentHash, mode, nowMs) {
  const s = String(status || '').trim().toUpperCase();
  if (mode === 'all') return true;
  if (s === 'IMPORTED' || s === 'DUPLICATE') return !String(orderNo || '').trim();
  if (s === 'REJECTED') return mode === 'retryRejected' || String(storedHash || '') !== currentHash;
  if (s === 'ERROR') {
    if (mode === 'retryRejected') return true;
    const m = /^E(\d+)\|(\d+)$/.exec(String(storedHash || ''));
    if (!m) return true;                               // legacy ERROR rows: retry once, state is recorded afterwards
    if (parseInt(m[1], 10) >= MAX_ATTEMPTS) return false;
    return (nowMs === undefined ? Date.now() : nowMs) >= parseInt(m[2], 10);
  }
  return true; // blank, SKIPPED, unknown
}

// Identifies THIS spreadsheet/tab to CODOPS (md5 prefix of the id, never the id itself), so stale copies that still post can be found.
function clientInfo_(ss) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, ss.getId());
  const hex = bytes.map(function (b) { return ('0' + (b < 0 ? b + 256 : b).toString(16)).slice(-2); }).join('');
  return { spreadsheet: hex.slice(0, 6), tab: SOURCE_SHEET_NAME, version: 'v2' };
}

function syncLeads_(mode) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) { console.log('Another sync is running; skipping this tick.'); return; }
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(SOURCE_SHEET_NAME);
    if (!sheet) throw new Error('Sheet not found: ' + SOURCE_SHEET_NAME);
    const headers0 = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1)).getValues()[0].map(function (v) { return String(v || '').trim(); });
    const statusCol = ensureColumn(sheet, headers0, STATUS_HEADER);
    const orderCol = ensureColumn(sheet, headers0, ORDER_HEADER);
    const errorCol = ensureColumn(sheet, headers0, ERROR_HEADER);
    const hashCol = ensureColumn(sheet, headers0, HASH_HEADER);
    SpreadsheetApp.flush();
    const values = sheet.getDataRange().getValues();   // read AFTER the helper columns exist
    if (values.length < 2) return;
    const headers = values[0].map(function (v) { return String(v || '').trim(); });

    const stats = { sent: 0, inserted: 0, duplicate: 0, rejected: 0, failed: 0, skipped: 0, unchanged: 0, collisions: 0 };
    const pending = [];
    function put(rowNumber, status, orderNo, error, hash) {
      const cur = values[rowNumber - 1] || [];
      if (String(cur[statusCol - 1] || '') !== status) sheet.getRange(rowNumber, statusCol).setValue(status);
      if (orderNo !== null && String(cur[orderCol - 1] || '') !== orderNo) sheet.getRange(rowNumber, orderCol).setValue(orderNo);
      if (String(cur[errorCol - 1] || '') !== error) sheet.getRange(rowNumber, errorCol).setValue(error);
      if (hash !== null && String(cur[hashCol - 1] || '') !== hash) sheet.getRange(rowNumber, hashCol).setValue(hash);
    }

    for (let r = 1; r < values.length; r++) {
      const row = values[r];
      if (!row.some(function (v) { return String(v || '').trim() !== ''; })) continue;
      const rowNumber = r + 1;
      const phone = String(getCell(row, headers, 'phone') || '').trim();
      const customer = String(getCell(row, headers, 'customer_name') || '').trim();
      if (!phone || !customer) {
        stats.skipped++;
        put(rowNumber, 'SKIPPED', null, 'Missing ' + (!customer ? 'customer name' : 'phone'), null);
        continue;
      }
      const sku = String(getCell(row, headers, 'sku') || '').trim();
      const qty = Math.max(parseInt(getCell(row, headers, 'quantity'), 10) || 1, 1);
      const totalRaw = getCell(row, headers, 'total_price');
      const total = totalRaw === '' ? null : Number(totalRaw);
      const hash = rowHash_(sku, phone, customer, qty, total);
      const status = row[statusCol - 1], orderNo = row[orderCol - 1], storedHash = row[hashCol - 1];
      if (!shouldSend_(status, orderNo, storedHash, hash, mode, Date.now())) { stats.unchanged++; continue; }
      const dateRaw = getCell(row, headers, 'lead_date');
      pending.push({
        rowNumber: rowNumber, hash: hash, storedHash: String(storedHash || ''),
        payload: {
          row_number: rowNumber, sku: sku, customer_name: customer, phone: phone,
          city: String(getCell(row, headers, 'city') || '').trim(), address: String(getCell(row, headers, 'address') || '').trim(),
          quantity: qty, total_price: (total === null || isNaN(total)) ? null : total,
          product_name: String(getCell(row, headers, 'product_name') || '').trim(),
          // Only a REAL order id is sent. Row position is never used as identity; the server derives a stable fingerprint instead.
          external_order_id: String(getCell(row, headers, 'external_order_id') || '').trim(),
          lead_date: dateRaw instanceof Date ? Utilities.formatDate(dateRaw, 'Africa/Casablanca', "yyyy-MM-dd'T'HH:mm:ss") : String(dateRaw || '').trim(),
          note: String(getCell(row, headers, 'note') || '').trim()
        }
      });
    }

    const startedAt = Date.now();
    for (let i = 0; i < pending.length; i += BATCH_SIZE) {
      if (Date.now() - startedAt > 240000) { stats.deferred = pending.length - i; break; }  // stay under the 6-minute Apps Script limit; the rest goes out next tick
      const chunk = pending.slice(i, i + BATCH_SIZE);
      const response = UrlFetchApp.fetch(CALL_CENTER_WEBHOOK, {
        method: 'post', contentType: 'application/json', headers: { 'X-Webhook-Token': CALL_CENTER_TOKEN },
        payload: JSON.stringify({ client: clientInfo_(ss), orders: chunk.map(function (c) { return c.payload; }) }), muteHttpExceptions: true
      });
      const code = response.getResponseCode();
      if (code < 200 || code >= 300) throw new Error('Call Center HTTP ' + code + ': ' + response.getContentText().slice(0, 300));
      const body = JSON.parse(response.getContentText());
      stats.sent += chunk.length;
      const byRow = {};
      chunk.forEach(function (c) { byRow[c.rowNumber] = c; });
      (body.results || []).forEach(function (res) {
        const rowNumber = Number(res.row_number);
        if (!rowNumber) return;
        const outcome = res.outcome || (res.status === 'IMPORTED' ? 'INSERTED' : 'FAILED');
        const orderRef = String(res.order_number || res.order_id || '');
        if (outcome === 'INSERTED') { stats.inserted++; if (res.collision) stats.collisions++; put(rowNumber, 'IMPORTED', orderRef, '', ''); }
        else if (outcome === 'DUPLICATE') { stats.duplicate++; put(rowNumber, 'DUPLICATE', orderRef, '', ''); }
        else if (outcome === 'REJECTED') { stats.rejected++; put(rowNumber, 'REJECTED', '', String(res.error || ''), byRow[rowNumber] ? byRow[rowNumber].hash : ''); }
        else { stats.failed++; put(rowNumber, 'ERROR', '', String(res.error || 'Unknown error'), nextRetryState_(byRow[rowNumber] ? byRow[rowNumber].storedHash : '', Date.now())); }
      });
    }
    stats.mode = mode; stats.at = new Date().toISOString();
    PropertiesService.getScriptProperties().setProperty('LAST_SYNC', JSON.stringify(stats));
    console.log('SYNC ' + JSON.stringify(stats));
  } finally {
    lock.releaseLock();
  }
}

function sendNewLeadsToCallCenter() { syncLeads_('normal'); }
// Controlled retry for REJECTED rows (run after adding the missing product / fixing the SKU mapping).
function retryRejectedRowsToCallCenter() { syncLeads_('retryRejected'); }
// Recovery: re-sends EVERY row. Server is idempotent (stable id / fingerprint), so existing orders are never duplicated or modified.
function resendAllRowsToCallCenter() { syncLeads_('all'); }
function showLastSync() { console.log(PropertiesService.getScriptProperties().getProperty('LAST_SYNC') || 'No sync recorded yet'); }

function installEveryMinuteTrigger() {
  ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === 'sendNewLeadsToCallCenter'; }).forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('sendNewLeadsToCallCenter').timeBased().everyMinutes(1).create();
}

function removeCallCenterTriggers() {
  ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === 'sendNewLeadsToCallCenter'; }).forEach(function (t) { ScriptApp.deleteTrigger(t); });
}

